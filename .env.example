# The public Google Sheet that holds the products.
# Paste the long code from the Sheet's address (the whole address also works):
#   https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
# Leave it empty to run the site with built-in demo products.
SHEET_ID=

# Telegram contact that receives orders: a phone number WITH country code
# (digits only, e.g. 251911223344) or a Telegram username (e.g. vionshop).
NEXT_PUBLIC_TELEGRAM=

# Phone number shown on the site and used by the Call button, e.g. +251 91 122 3344
NEXT_PUBLIC_PHONE=

# Optional: the public address of the site, used for links in Telegram
# messages and social previews. On Vercel this is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
